{
	"name": "kurodasensei/siteferry",
	"description": "Siteferry: migraciones de base de datos para WordPress.",
	"type": "wordpress-plugin",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": { "Siteferry\\": "src/" }
	},
	"autoload-dev": {
		"psr-4": { "Siteferry\\Tests\\": "tests/" }
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs"
	},
	"config": {
		"allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }
	}
}
