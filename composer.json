{
	"name": "kurodasensei/siteferry",
	"description": "WordPress migrations: serialized-safe search-replace, export, import, and signed pull/push of databases and files.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{ "name": "Kuroda Sensei", "homepage": "https://kurodasensei.dev" }
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": { "Siteferry\\": "src/" }
	},
	"autoload-dev": {
		"psr-4": { "Siteferry\\Tests\\": "tests/" }
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs"
	},
	"config": {
		"allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }
	}
}
