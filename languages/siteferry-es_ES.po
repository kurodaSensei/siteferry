#. Plugin Name of the plugin
#: siteferry.php
msgid "Siteferry"
msgstr "Siteferry"

#. Description of the plugin
#: siteferry.php
msgid "Export, import and search-replace the WordPress database safely across serialized data, and move databases and files between sites."
msgstr "Exporta, importa y hace buscar/reemplazar en la base de datos de WordPress, seguro con datos serializados, y mueve bases de datos y archivos entre sitios."

#. Author of the plugin
#: siteferry.php
msgid "Kuroda Sensei"
msgstr "Kuroda Sensei"

#: src/Admin/Page.php:70
msgid "Action"
msgstr "Acción"

#: src/Admin/Page.php:73
#: assets/siteferry.js:34
msgid "Export"
msgstr "Exportar"

#: src/Admin/Page.php:74
msgid "Download the database as a .sql.gz, with optional replacements for the destination site."
msgstr "Descarga la base de datos en un .sql.gz, con reemplazos opcionales para el sitio de destino."

#: src/Admin/Page.php:78
#: assets/siteferry.js:35
msgid "Search and replace"
msgstr "Buscar y reemplazar"

#: src/Admin/Page.php:79
msgid "Change text on this site, including inside serialized data and JSON."
msgstr "Cambia textos en este sitio, también dentro de datos serializados y JSON."

#: src/Admin/Page.php:83
#: assets/siteferry.js:36
msgid "Import"
msgstr "Importar"

#: src/Admin/Page.php:84
msgid "Replace this site’s database with one from a .sql or .sql.gz file."
msgstr "Reemplaza la base de datos de este sitio por la de un .sql o .sql.gz."

#: src/Admin/Page.php:88
#: assets/siteferry.js:37
msgid "Pull"
msgstr "Pull"

#: src/Admin/Page.php:89
msgid "Bring another site’s database here and replace this one."
msgstr "Trae la base de datos de otro sitio y reemplaza la de este."

#: src/Admin/Page.php:93
#: assets/siteferry.js:38
msgid "Push"
msgstr "Push"

#: src/Admin/Page.php:94
msgid "Send this site’s database to another site and replace the one there."
msgstr "Envía la base de datos de este sitio a otro y reemplaza la de allá."

#: src/Admin/Page.php:99
msgid "Remote site"
msgstr "Sitio remoto"

#: src/Admin/Page.php:101
msgid "Copy the connection info from Tools → Siteferry on the other site."
msgstr "Copia la información de conexión desde Herramientas → Siteferry del otro sitio."

#: src/Admin/Page.php:102
msgid "Connect"
msgstr "Conectar"

#: src/Admin/Page.php:106
msgid "What to transfer"
msgstr "Qué transferir"

#: src/Admin/Page.php:107
msgid "Database"
msgstr "Base de datos"

#: src/Admin/Page.php:108
#: src/Admin/Page.php:118
msgid "Media (uploads)"
msgstr "Media (uploads)"

#: src/Admin/Page.php:109
#: src/Admin/Page.php:119
msgid "Themes"
msgstr "Temas"

#: src/Admin/Page.php:110
#: src/Admin/Page.php:120
msgid "Plugins"
msgstr "Plugins"

#: src/Admin/Page.php:111
#: src/Admin/Page.php:121
msgid "Must-use plugins (mu-plugins)"
msgstr "Plugins obligatorios (mu-plugins)"

#: src/Admin/Page.php:112
msgid "Delete files on the destination that don’t exist on the source (kept in a backup for 7 days)"
msgstr "Borrar en el destino los archivos que no existen en el origen (se guardan en un backup 7 días)"

#: src/Admin/Page.php:113
msgid "Only what changed is transferred. Themes and plugins are swapped as whole folders at the end, and Siteferry never replaces itself. For a push, the other site must allow “code push” for themes and plugins."
msgstr "Solo viaja lo que cambió. Temas y plugins se cambian por carpeta completa al final, y Siteferry nunca se reemplaza a sí mismo. En un push, el otro sitio debe permitir «push de código» para temas y plugins."

#: src/Admin/Page.php:117
msgid "Include files (full-site .sfy package)"
msgstr "Incluir archivos (paquete de sitio completo .sfy)"

#: src/Admin/Page.php:122
msgid "Without files you get the database (.sql.gz). With files, a .sfy package with everything, which you import on another site with Siteferry."
msgstr "Sin archivos se descarga la base de datos (.sql.gz). Con archivos, un paquete .sfy con todo, que se importa en otro sitio con Siteferry."

#: src/Admin/Page.php:126
msgid "File"
msgstr "Archivo"

#: src/Admin/Page.php:128
msgid "A mysqldump or phpMyAdmin dump, a .sql.gz export, or a Siteferry .sfy site package. The table prefix and the source site URL are detected automatically."
msgstr "mysqldump, phpMyAdmin, una exportación .sql.gz o un paquete de sitio .sfy de Siteferry. El prefijo de tablas y la URL del sitio de origen se detectan solos."

#: src/Admin/Page.php:130
msgid "Table prefix in the file (optional)"
msgstr "Prefijo de tablas del archivo (opcional)"

#: src/Admin/Page.php:132
msgid "Only needed if the file holds several WordPress installs; the plugin will tell you."
msgstr "Solo si el archivo trae varias instalaciones de WordPress; el plugin te avisa."

#: src/Admin/Page.php:137
msgid "Replacements"
msgstr "Reemplazos"

#: src/Admin/Page.php:139
#: src/Admin/Page.php:142
msgid "Find"
msgstr "Buscar"

#: src/Admin/Page.php:139
#: src/Admin/Page.php:143
msgid "Replace with"
msgstr "Reemplazar por"

#: src/Admin/Page.php:139
msgid "Remove"
msgstr "Quitar"

#: src/Admin/Page.php:144
msgid "Remove pair"
msgstr "Quitar par"

#: src/Admin/Page.php:148
msgid "Add pair"
msgstr "Añadir par"

#: src/Admin/Page.php:150
msgid "Automatically replace the source site URL with the destination URL"
msgstr "Cambiar automáticamente la URL del sitio de origen por la del destino"

#: src/Admin/Page.php:151
msgid "Case sensitive"
msgstr "Distinguir mayúsculas"

#: src/Admin/Page.php:152
msgid "Regular expressions (PCRE with delimiters, e.g. #https?://old\\.test#)"
msgstr "Expresiones regulares (PCRE con delimitadores, p. ej. #https?://viejo\\.test#)"

#: src/Admin/Page.php:153
msgid "Also replace in guid (usually you should not)"
msgstr "Reemplazar también en guid (normalmente no se debe)"

#. translators: %d: number of tables
#: src/Admin/Page.php:158
#: assets/siteferry.js:81
#, php-format,js-format
msgid "Tables (%d)"
msgstr "Tablas (%d)"

#. translators: %d: number of tables
#: src/Admin/Page.php:159
msgid "Select / deselect all"
msgstr "Marcar / desmarcar todas"

#: src/Admin/Page.php:168
msgid "Back up the destination database first (kept for 7 days)"
msgstr "Crear un backup de la base de datos de destino antes (se conserva 7 días)"

#: src/Admin/Page.php:171
msgid "Start"
msgstr "Iniciar"

#: src/Admin/Page.php:181
msgid "Resume"
msgstr "Continuar"

#: src/Admin/Page.php:182
msgid "Cancel"
msgstr "Cancelar"

#: src/Admin/Page.php:183
msgid "New operation"
msgstr "Nueva operación"

#: src/Admin/Page.php:185
msgid "Log"
msgstr "Registro"

#: src/Admin/Page.php:189
msgid "Undo the last operation"
msgstr "Deshacer la última operación"

#: src/Admin/Page.php:191
#: assets/siteferry.js:39
msgid "Undo"
msgstr "Deshacer"

#: src/Admin/Page.php:195
msgid "This site’s connection"
msgstr "Conexión de este sitio"

#: src/Admin/Page.php:196
msgid "Paste this on the other site to pull from or push to this one. Anyone with the key can read or replace this database, depending on the permissions below: treat it like a password."
msgstr "Pega esto en el otro sitio para hacer pull o push con este. Quien tenga la clave puede leer o reemplazar esta base de datos según los permisos de abajo: trátala como una contraseña."

#: src/Admin/Page.php:199
msgid "Copy"
msgstr "Copiar"

#: src/Admin/Page.php:200
msgid "Regenerate key"
msgstr "Regenerar clave"

#: src/Admin/Page.php:203
msgid "Permissions"
msgstr "Permisos"

#: src/Admin/Page.php:204
msgid "Allow pull: other sites can read this database"
msgstr "Permitir pull: otros sitios pueden leer esta base de datos"

#: src/Admin/Page.php:205
msgid "Allow file pull: other sites can read media, themes and plugins (including their code)"
msgstr "Permitir pull de archivos: otros sitios pueden leer media, temas y plugins (incluido su código)"

#: src/Admin/Page.php:206
msgid "Allow push: other sites can replace this database"
msgstr "Permitir push: otros sitios pueden reemplazar esta base de datos"

#: src/Admin/Page.php:207
msgid "Allow code push: other sites can replace this site’s themes and plugins"
msgstr "Permitir push de código: otros sitios pueden reemplazar temas y plugins de este sitio"

#: src/Admin/Page.php:208
msgid "Verify the HTTPS certificate when connecting to other sites (turn off only for local development)"
msgstr "Verificar el certificado HTTPS al conectarse a otros sitios (desactívalo solo en desarrollo local)"

#: src/Admin/Page.php:227
#: assets/siteferry.js:426
msgid "database"
msgstr "base de datos"

#: src/Admin/Page.php:230
#: assets/siteferry.js:426
msgid "files"
msgstr "archivos"

