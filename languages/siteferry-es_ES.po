#: src/Admin/Page.php:233
#: assets/siteferry.js:428
#, php-format,js-format
msgid "%1$s · %2$s · restores: %3$s."
msgstr "%1$s · %2$s · se restaura: %3$s."

#: src/Http/RestController.php:93
msgid "The uploaded file was not found."
msgstr "No se encontró el archivo subido."

#: src/Http/RestController.php:178
msgid "Another step is in progress."
msgstr "Otro paso está en curso."

#: src/Http/RestController.php:199
msgid "A step is in progress; try again."
msgstr "Hay un paso en curso; inténtalo de nuevo."

#: src/Http/RestController.php:226
msgid "The file is not available."
msgstr "El archivo no está disponible."

#: src/Http/RestController.php:258
msgid "Only .sql, .sql.gz or .sfy files are accepted."
msgstr "Solo se aceptan archivos .sql, .sql.gz o .sfy."

#: src/Http/RestController.php:261
msgid "The file chunk did not arrive."
msgstr "No llegó el trozo del archivo."

#: src/Http/RestController.php:268
msgid "The chunk is out of order."
msgstr "El trozo no está en orden."

#: src/Http/RestController.php:299
msgid "That operation no longer exists."
msgstr "Esa operación ya no existe."

#: src/Plugin.php:134
msgid "Another operation is already in progress."
msgstr "Ya hay una operación en curso."

#: src/Plugin.php:137
msgid "Unknown action."
msgstr "Acción desconocida."

#: src/Plugin.php:141
msgid "There is nothing to undo."
msgstr "No hay nada que deshacer."

#. translators: %s: Siteferry version on the remote site
#: src/Plugin.php:164
#, php-format
msgid "The remote site runs a different Siteferry version (%s). Update both."
msgstr "El sitio remoto usa otra versión de Siteferry (%s). Actualiza ambos."

#. translators: 1: first item, 2: second item
#: assets/siteferry.js:18
#, js-format
msgid "%1$s and %2$s"
msgstr "%1$s y %2$s"

#: assets/siteferry.js:27
msgid "Queued…"
msgstr "En cola…"

#: assets/siteferry.js:28
msgid "Working…"
msgstr "Trabajando…"

#: assets/siteferry.js:29
msgid "Done"
msgstr "Terminado"

#: assets/siteferry.js:30
msgid "Failed"
msgstr "Falló"

#: assets/siteferry.js:31
msgid "Cancelled"
msgstr "Cancelado"

#: assets/siteferry.js:77
msgid "Connect to the remote site to see its tables."
msgstr "Conecta con el sitio remoto para ver sus tablas."

#: assets/siteferry.js:104
msgid "Connecting…"
msgstr "Conectando…"

#: assets/siteferry.js:108
msgid "nothing (enable it there)"
msgstr "nada (actívalo allá)"

#: assets/siteferry.js:109
msgid "yes"
msgstr "sí"

#: assets/siteferry.js:109
msgid "no"
msgstr "no"

#. translators: 1: remote URL, 2: table prefix, 3: number of tables, 4: allowed operations, 5: file pull yes/no, 6: code push yes/no
#: assets/siteferry.js:112
#, js-format
msgid "Connected to %1$s · prefix %2$s · %3$d tables · allows %4$s · file pull: %5$s · code push: %6$s."
msgstr "Conectado con %1$s · prefijo %2$s · %3$d tablas · permite %4$s · pull de archivos: %5$s · push de código: %6$s."

#: assets/siteferry.js:121
msgid "Could not connect."
msgstr "No se pudo conectar."

#: assets/siteferry.js:195
msgid "Enter at least one text to find."
msgstr "Indica al menos un texto a buscar."

#: assets/siteferry.js:200
msgid "Choose the file to import."
msgstr "Elige el archivo a importar."

#: assets/siteferry.js:202
msgid "This site’s database will be replaced with the one in the file. Continue?"
msgstr "La base de datos de este sitio se reemplazará por la del archivo. ¿Continuar?"

#: assets/siteferry.js:210
msgid "This site’s data will be modified. Continue?"
msgstr "Se modificarán los datos de este sitio. ¿Continuar?"

#: assets/siteferry.js:214
msgid "Paste the other site’s connection info."
msgstr "Pega la información de conexión del otro sitio."

#: assets/siteferry.js:217
msgid "Choose the database, files, or both."
msgstr "Elige la base de datos, archivos o ambos."

#: assets/siteferry.js:221
msgid "The other site does not allow file pulls. Enable it there or clear the file checkboxes."
msgstr "El otro sitio no permite pull de archivos. Actívalo allá o quita las casillas de archivos."

#: assets/siteferry.js:224
msgid "The other site does not allow code pushes (themes and plugins). Enable it there or clear those checkboxes."
msgstr "El otro sitio no permite push de código (temas y plugins). Actívalo allá o quita esas casillas."

#: assets/siteferry.js:226
msgid "the other site"
msgstr "el otro sitio"

#: assets/siteferry.js:228
msgid "the database"
msgstr "la base de datos"

#. translators: %s: list of folders
#: assets/siteferry.js:230
#, js-format
msgid "files (%s)"
msgstr "archivos (%s)"

#. translators: 1: what gets replaced, 2: other site URL
#: assets/siteferry.js:235
#, js-format
msgid "%1$s on THIS site will be replaced with the ones from %2$s. Continue?"
msgstr "Se reemplazarán %1$s de ESTE sitio por los de %2$s. ¿Continuar?"

#. translators: 1: what gets replaced, 2: other site URL
#: assets/siteferry.js:241
#, js-format
msgid "%1$s on %2$s will be replaced with the ones from this site. Continue?"
msgstr "Se reemplazarán %1$s de %2$s por los de este sitio. ¿Continuar?"

#: assets/siteferry.js:261
msgid "Uploading file…"
msgstr "Subiendo archivo…"

#. translators: 1: bytes uploaded, 2: file size
#: assets/siteferry.js:276
#, js-format
msgid "%1$s of %2$s"
msgstr "%1$s de %2$s"

#: assets/siteferry.js:333
msgid "The site’s tables were not modified; “Cancel” cleans up the temporary data."
msgstr "Las tablas del sitio no se modificaron; «Cancelar» limpia lo temporal."

#: assets/siteferry.js:340
msgid "Done. If you were logged out, log in again with a user from the source site."
msgstr "Terminado. Si se cerró tu sesión, vuelve a iniciar sesión con un usuario del sitio de origen."

#. translators: 1: file name, 2: file size
#: assets/siteferry.js:350
#, js-format
msgid "Download (%1$s, %2$s)"
msgstr "Descargar (%1$s, %2$s)"

#. translators: 1: file name, 2: file size
#: assets/siteferry.js:351
#, js-format
msgid "Download backup (%1$s, %2$s)"
msgstr "Descargar backup (%1$s, %2$s)"

#: assets/siteferry.js:385
msgid "Unknown error."
msgstr "Error desconocido."

#: assets/siteferry.js:391
msgid "You can resume once it is fixed."
msgstr "Puedes continuar cuando se resuelva."

#: assets/siteferry.js:403
msgid "Cancel the operation? Temporary tables and files will be deleted."
msgstr "¿Cancelar la operación? Se borran las tablas y archivos temporales."

#: assets/siteferry.js:432
msgid "The site will be restored to its state before the last operation. Anything changed on this site since then is lost, and this cannot itself be undone. Continue?"
msgstr "Se restaurará el estado anterior a la última operación. Lo cambiado después en este sitio se pierde y no se puede deshacer a su vez. ¿Continuar?"

#: assets/siteferry.js:452
msgid "Saved."
msgstr "Guardado."

#: assets/siteferry.js:455
msgid "Could not save."
msgstr "No se pudo guardar."

#: assets/siteferry.js:465
msgid "Copied."
msgstr "Copiado."

#: assets/siteferry.js:468
msgid "Sites using the current key will no longer be able to connect. Regenerate?"
msgstr "Los sitios que usan la clave actual dejarán de poder conectarse. ¿Regenerar?"

#: assets/siteferry.js:473
msgid "New key generated."
msgstr "Clave nueva generada."
